/**
 * bx-couchcache
 * The provider is Java and registers itself via ServiceLoader when the module loads.
 * The only wiring is onUnload, which closes the module's caches before its class loader goes away.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	this.version     = "@build.version@";
	this.mapping     = "couchcache";
	this.author      = "Robert";
	this.description = "Open-source Couchbase cache provider for BoxLang";
	this.enabled     = true;

	function configure(){
		settings = {};
	}

	function onUnload(){
		createObject( "java", "com.kisdigital.couchcache.CouchCacheProvider@couchcache" ).shutdownAll();
	}

}
